# Copy this file to `.env` and fill in values. Keep `.env` out of version control.
#   cp .env.example .env

# --- Database (Prisma) ---
DATABASE_URL=
DIRECT_URL=

# --- Supabase (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# If your project uses the newer name instead:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server-only; never use NEXT_PUBLIC_ for this) ---
# Prefer Legacy API keys → service_role (long JWT). New Secret keys (`sb_secret_...`) can hit
# “Invalid Compact JWS” on Storage until the stack fully supports opaque keys; use service_role if so.
SUPABASE_SERVICE_ROLE_KEY=
# Optional; default bucket name is price-books
# SUPABASE_PRICE_BOOK_BUCKET=price-books

# --- Admin allowlist (comma-separated emails) ---
NORTHLINE_ADMIN_EMAILS=

# --- Optional: public site URL for magic links / invites ---
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=

# --- Optional: Resend (participant invites from admin) ---
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# --- Optional: scheduled assessment invite delivery ---
# Production: set CRON_SECRET in Vercel env; vercel.json runs /api/cron/send-scheduled-invites every 5 min.
# Local dev: `next dev` auto-polls every 60s (disable with DISABLE_DEV_INVITE_CRON=1).
# Manual run: npm run cron:invites
# CRON_SECRET=

# --- Optional: Private AI Workbench — multi-model routing ---
# Fast (Ollama / Mistral 7B): document prep, extraction, quick summaries
# FAST_LLM_PROVIDER=ollama
# FAST_LLM_BASE_URL=http://localhost:11434
# FAST_LLM_MODEL=mistral
# FAST_LLM_API_KEY=

# Executive (RunPod / vLLM / Mistral 24B): strategic readouts, risk, roadmaps
# EXECUTIVE_LLM_PROVIDER=runpod
# EXECUTIVE_LLM_BASE_URL=
# EXECUTIVE_LLM_MODEL=mistralai/Mistral-Small-3.2-24B-Instruct-2506
# EXECUTIVE_LLM_API_KEY=

# DEFAULT_AI_MODE=auto

# --- Optional: Executive Insights / project scope (Anthropic) ---
# ANTHROPIC_API_KEY=
# NARRATIVE_AI_ENABLED=false
# NARRATIVE_AI_MODEL=
# NARRATIVE_WEB_CONTEXT_MODEL=
# NARRATIVE_WEB_ENRICHMENT_ENABLED=true
# ALLOW_NARRATIVE_FORCE=false
