generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                 String                 @id @default(uuid()) @db.Uuid
  name               String
  industry           String?
  size               String?
  growth_stage       String?
  primary_pressures  String?

  /// Admin-entered website for narrative + enrichment
  website            String?

  /// Admin-pasted context about the org (what they do, ICP, offerings, etc.)
  context_notes      String?
  /// Known systems currently in use (CRM/PM/support/BI/etc).
  tech_stack_notes   String?
  /// Known integration patterns and dependencies across systems.
  integration_notes  String?
  /// Known internal processes/workflow structure across teams.
  process_workflow_notes String?
  /// Latest AI-generated current-state workflow map summary.
  workflow_map_ai_summary String? @db.Text
  workflow_map_ai_updated_at DateTime?
  /// Google Drive root folder id for this organization.
  google_drive_root_folder_id String?
  /// Google Drive "Customer Library" folder id under org root.
  google_drive_library_folder_id String?
  legal_name         String?
  legal_entity_type  String?
  ein                String?
  legal_address      String?
  state_of_incorporation String?
  primary_contact_name String?
  primary_contact_title String?
  primary_contact_email String?
  primary_contact_phone String?
  billing_contact_name String?
  billing_email      String?
  payment_method     String?

  created_at         DateTime               @default(now())
  assessments        Assessment[]
  documents          OrganizationDocument[]
  participants       Participant[]
  show_admin_controls Boolean               @default(false)
  /// When true, Executive Insights shows a Project Scope link (AI-generated scopes per pilot).
  show_project_scope_review Boolean        @default(false)

  /// CRM: consulting pipeline stage for this client account
  crm_pipeline_stage     CrmPipelineStage  @default(NEW_PROSPECT)
  crm_stage_updated_at    DateTime?
  /// Next follow-up / action due (used for overdue alerts)
  crm_next_follow_up_at DateTime?
  crm_internal_notes    String?            @db.Text

  org_contacts   OrgContact[]
  crm_quotes     CrmQuote[]
  crm_contracts  CrmContract[]
  crm_invoices   CrmInvoice[]
  pm_projects    PmProject[]
  crm_msas       CrmMsa[]

  @@index([name])
  @@index([created_at])
  @@index([crm_pipeline_stage])
  @@index([crm_next_follow_up_at])
}

model Assessment {
  id                String           @id @default(uuid()) @db.Uuid
  organization_id   String           @db.Uuid
  cohort_name       String?
  assessment_date   DateTime?
  status            AssessmentStatus @default(DRAFT)
  locked_at         DateTime?
  created_at        DateTime         @default(now())
  type              assessmenttype   @default(FULL)
  name              String           @default("NL-Assess")

  /// If set, this assessment is "team-only locked" and participants do NOT choose a department.
  /// All questions should be filtered to audience = locked_department OR ALL.
  locked_department Department?
  /// Industry track selected in assessment configuration; drives industry-specific question bank.
  industry Industry?

  organization       Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  Participant        Participant[]
  Response           Response[]
  narratives         AssessmentNarrative[]
  project_scopes     AssessmentProjectScope[]
  crm_quotes         CrmQuote[]
  pm_projects        PmProject[]

  @@index([organization_id])
  @@index([status])
  @@index([type])
  @@index([locked_department])
  @@index([industry])
  @@index([organization_id, created_at])
}

model Participant {
  id String @id @default(uuid()) @db.Uuid

  /// Supabase Auth user.id (UUID). Used for authorization + org membership enforcement.
  /// Optional for now to avoid breaking existing data; should become required before production.
  user_id String? @db.Uuid

  /// Participant intake: free-text notes about where AI automation could help (used for narrative grounding)
  ai_opportunities_notes String? @db.Text

  /// Invite / participant email for onboarding before the user is linked to Supabase auth.
  email String?

  /// Hardened invite system (Option B): token stored as a hash (never store raw token)
  invite_token_hash       String?
  invite_token_expires_at DateTime?
  invite_sent_at          DateTime?
  invite_accepted_at      DateTime?

  organization_id String   @db.Uuid
  role            String?
  seniority_level String?
  created_at      DateTime @default(now())
  assessment_id   String   @db.Uuid
   completed_at   DateTime? 
  /// Department/team the participant represents (used to select variant questions).
  /// If assessment.locked_department is set, this can be null.
  department Department?
  can_view_executive_insights Boolean @default(true)
  portal_role ParticipantPortalRole @default(NONE)

  Assessment   Assessment   @relation(fields: [assessment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  Response     Response[]

  @@unique([assessment_id, user_id], map: "participant_unique_per_assessment_user")
  @@unique([assessment_id, email], map: "participant_unique_per_assessment_email")

  @@index([organization_id])
  @@index([user_id])
  @@index([email])
  @@index([organization_id, user_id])
  @@index([assessment_id, department])
  @@index([assessment_id, created_at])
}

enum ParticipantPortalRole {
  NONE
  PORTAL_USER
  ORG_ADMIN
}

model Question {
  id            String     @id @default(uuid()) @db.Uuid
  pillar        Pillar
  question_core String?
  question_text String
  display_order Int
  weight        Int        @default(1)
  active        Boolean    @default(true)
  version       String     @default("1.0")
  context_mode  QuestionContextMode @default(NONE)
  industry_context_json Json?
  created_at    DateTime   @default(now())

  /// Which department this question is targeted for.
  /// - ALL = included in every assessment/department
  /// - SALES/MARKETING/etc = included when participant/assessment matches that department
  audience Department @default(ALL)
  /// Industry segmentation for question banks.
  industry Industry @default(ALL_INDUSTRIES)

  /// Optional paired question for inverse-consistency checks (both averaging high suggests validation opportunity).
  inverse_question_id String? @db.Uuid
  inverse_question    Question?  @relation("QuestionInversePair", fields: [inverse_question_id], references: [id], onDelete: SetNull)
  inverse_of          Question[] @relation("QuestionInversePair")

  Response      Response[]

  @@unique([pillar, display_order, version, audience, industry])
  @@index([pillar, active])
  @@index([version, audience, industry, active])
}

enum QuestionContextMode {
  APPEND
  INLINE
  NONE
}

model Response {
  id             String      @id @default(uuid()) @db.Uuid
  assessment_id  String      @db.Uuid
  participant_id String      @db.Uuid
  question_id    String      @db.Uuid
  score          Int
  free_write     String?
  created_at     DateTime    @default(now())

  Assessment     Assessment  @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  Participant    Participant @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  Question       Question    @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([assessment_id, participant_id, question_id], map: "response_unique_per_participant_question")
  @@index([assessment_id, participant_id])
  @@index([assessment_id, question_id])
}

model AssessmentNarrative {
  id            String @id @default(uuid()) @db.Uuid
  assessment_id String @db.Uuid

  /// Version number per assessment (1, 2, 3...). Increment on each generation.
  version Int

  /// Lifecycle: DRAFT while iterating; FINAL when delivered; ARCHIVED for old/hidden versions.
  status NarrativeStatus @default(DRAFT)

  /// Hash of the canonical inputs used to generate this narrative
  /// (diagnostic results + org context + documents fingerprints).
  input_hash String

  /// Audit metadata (keep conservative; no secrets here).
  engine_version String  @default("v1.1")
  schema_version String  @default("1.0")
  prompt_version String?
  model_name     String?
  model_provider String?

  /// Structured output (guardrailed JSON). Validate with Zod before insert.
  narrative_json Json

  /// Optional human-readable render target for PDF/export.
  memo_markdown String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Assessment Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  @@unique([assessment_id, version], map: "narrative_unique_per_assessment_version")
  @@index([assessment_id, status])
  @@index([assessment_id, created_at])
  @@index([assessment_id, status, created_at])
}

/// AI-generated executive project scopes (one row per generation; latest by version).
model AssessmentProjectScope {
  id            String @id @default(uuid()) @db.Uuid
  assessment_id String @db.Uuid

  version    Int
  input_hash String

  engine_version String  @default("v1")
  schema_version String  @default("1.0")
  model_name     String?
  model_provider String?

  scope_json Json

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Assessment Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  @@unique([assessment_id, version], map: "project_scope_unique_per_assessment_version")
  @@index([assessment_id, created_at])
}

model OrganizationDocument {
  id              String       @id @default(uuid()) @db.Uuid
  organization_id String       @db.Uuid
  title           String
  source_type     String
  source_url      String?
  storage_path    String?
  /// Drive file id when synced to Google Drive.
  google_drive_file_id String?
  mime_type       String?
  text_extracted  String?
  created_at      DateTime     @default(now())
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, source_type])
  @@index([organization_id, created_at])
}

enum Pillar {
  SYSTEM_INTEGRITY
  HUMAN_ALIGNMENT
  STRATEGIC_COHERENCE
  SUSTAINABILITY_PRACTICE
}

enum Department {
  /// Included for every participant/assessment unless you explicitly choose to filter it out.
  ALL
  SALES
  MARKETING
  CUSTOMER_SUCCESS
  LOGISTICS_SUPPLY_CHAIN
  IT
  OPS
  REVOPS
  ENGINEERING
  PRODUCT
  GTM
}

enum Industry {
  ALL_INDUSTRIES
  LOGISTICS_TRANSPORTATION
  MANUFACTURING_INDUSTRIAL
  TECHNOLOGY_SAAS
  HEALTHCARE_LIFE_SCIENCES
  FINANCIAL_SERVICES
  RETAIL_ECOMMERCE
  PROFESSIONAL_SERVICES
  CONSTRUCTION_REAL_ESTATE
  ENERGY_UTILITIES
  EDUCATION_TRAINING
  HOSPITALITY_TRAVEL
  NONPROFIT_PUBLIC_SECTOR
  MEDIA_ENTERTAINMENT
  AGRICULTURE_FOOD_PRODUCTION
  OTHER_HYBRID
}

enum AssessmentStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum assessmenttype {
  FULL
  LITE
}

enum NarrativeStatus {
  DRAFT
  FINAL
  ARCHIVED
}

/// Client consulting / sales pipeline (CRM)
enum CrmPipelineStage {
  NEW_PROSPECT
  CONSULTATION
  ASSESSMENT_ACTIVE
  ASSESSMENT_COMPLETE
  WORKSHOP_SCHEDULED
  WORKSHOP_CONDUCTED
  QUOTE_DRAFTED
  QUOTE_DELIVERED
  QUOTE_ACCEPTED
}

enum CrmQuoteStatus {
  DRAFT
  SENT
  ACTIVE
  APPROVED
  CLOSED_WON
  CLOSED_LOST
  ACCEPTED
  DECLINED
}

model OrgContact {
  id              String       @id @default(uuid()) @db.Uuid
  organization_id String       @db.Uuid
  name            String
  email           String?
  phone           String?
  title           String?
  is_archived     Boolean      @default(false)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organization          Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  quotes_as_signee      CrmQuote[]   @relation("QuoteSignee")
  quotes_as_billing     CrmQuote[]   @relation("QuoteBilling")

  @@index([organization_id])
  @@index([organization_id, is_archived])
}

/// Versioned services / SKU list for quoting (admin-maintained)
model PriceBook {
  id            String   @id @default(uuid()) @db.Uuid
  label         String
  is_current    Boolean  @default(false)
  /// [{ "sku": "...", "description": "...", "unit": "hour", "unit_price_cents": 10000 }]
  line_items    Json
  notes         String?
  source_filename String?
  /// Supabase Storage bucket name (e.g. price-books)
  storage_bucket String?
  /// Object path within the bucket
  storage_path   String?
  mime_type      String?
  created_at    DateTime @default(now())

  @@index([is_current])
  @@index([created_at])
}

model CrmQuote {
  id                     String          @id @default(uuid()) @db.Uuid
  organization_id        String          @db.Uuid
  assessment_id          String?         @db.Uuid
  project_scope_version  Int?
  /// Copy of project scope JSON when quote was created / last synced
  project_scope_snapshot Json?
  /// Full editable quote state: narrative, selected lines, custom lines, terms, etc.
  quote_payload          Json
  status                 CrmQuoteStatus  @default(DRAFT)
  signee_contact_id      String?         @db.Uuid
  billing_contact_id     String?         @db.Uuid
  total_cents            Int?
  valid_until            DateTime?
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  assessment   Assessment?  @relation(fields: [assessment_id], references: [id], onDelete: SetNull)
  signee       OrgContact?    @relation("QuoteSignee", fields: [signee_contact_id], references: [id], onDelete: SetNull)
  billing      OrgContact?    @relation("QuoteBilling", fields: [billing_contact_id], references: [id], onDelete: SetNull)

  crm_contracts CrmContract[]
  crm_invoices  CrmInvoice[]
  pm_projects   PmProject[]
  crm_msas      CrmMsa[]

  @@index([organization_id])
  @@index([organization_id, status])
  @@index([assessment_id])
}

model CrmContract {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  quote_id        String?  @db.Uuid
  title           String
  status          String   @default("DRAFT")
  body_notes      String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  quote        CrmQuote?    @relation(fields: [quote_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([status])
}

model CrmInvoice {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  title           String
  amount_cents    Int      @default(0)
  status          String   @default("DRAFT")
  due_date        DateTime?
  quote_id        String?  @db.Uuid
  notes           String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  quote        CrmQuote?    @relation(fields: [quote_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([status])
  @@index([due_date])
}

enum PmProjectStatus {
  PLANNED
  ACTIVE
  AT_RISK
  DELAYED
  OVERDUE
  COMPLETED
}

enum PmSprintStatus {
  NOT_STARTED
  ON_TIME
  DELAYED
  OVERDUE
  COMPLETED
}

model PmProject {
  id                  String          @id @default(uuid()) @db.Uuid
  organization_id     String          @db.Uuid
  quote_id            String?         @db.Uuid
  assessment_id       String?         @db.Uuid
  title               String
  status              PmProjectStatus @default(PLANNED)
  target_start_at     DateTime?
  target_end_at       DateTime?
  completion_pct      Int             @default(0)
  internal_notes      String?         @db.Text
  customer_summary    String?         @db.Text
  last_ai_summary     String?         @db.Text
  ai_summary_updated_at DateTime?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  quote        CrmQuote?    @relation(fields: [quote_id], references: [id], onDelete: SetNull)
  assessment   Assessment?  @relation(fields: [assessment_id], references: [id], onDelete: SetNull)
  sprints      PmSprint[]

  @@index([organization_id])
  @@index([organization_id, status])
  @@index([quote_id])
  @@index([assessment_id])
}

model PmSprint {
  id                String         @id @default(uuid()) @db.Uuid
  project_id        String         @db.Uuid
  sprint_number     Int
  title             String
  status            PmSprintStatus @default(NOT_STARTED)
  stage_label       String?
  cost_band         String?
  scope_summary     String?        @db.Text
  estimated_duration_value Float?
  estimated_duration_unit  String?
  estimated_completion_date DateTime?
  completion_pct    Int            @default(0)
  target_start_at   DateTime?
  target_end_at     DateTime?
  notes             String?        @db.Text
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  project PmProject        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  updates PmSprintUpdate[]

  @@unique([project_id, sprint_number], map: "pm_sprint_unique_per_project_number")
  @@index([project_id, status])
}

model PmSprintUpdate {
  id                 String   @id @default(uuid()) @db.Uuid
  sprint_id          String   @db.Uuid
  status_label       String
  why_text           String?  @db.Text
  is_customer_visible Boolean @default(false)
  author_email       String?
  created_at         DateTime @default(now())

  sprint PmSprint @relation(fields: [sprint_id], references: [id], onDelete: Cascade)

  @@index([sprint_id, created_at])
  @@index([is_customer_visible])
}

enum CrmMsaStatus {
  DRAFT
  INTERNAL_REVIEW
  SENT_TO_CLIENT
  CLIENT_REVIEW
  SIGNED
  SUPERSEDED
  ARCHIVED
}

model CrmMsa {
  id                         String       @id @default(uuid()) @db.Uuid
  organization_id            String       @db.Uuid
  source_quote_id            String?      @db.Uuid
  title                      String
  status                     CrmMsaStatus @default(DRAFT)
  version_number             Int          @default(1)
  terms_version              String?
  body_markdown              String?      @db.Text
  exhibit_a_snapshot_json    Json?
  exhibit_b_snapshot_json    Json?
  accepted_snapshot_text     String?      @db.Text
  accepted_by_name           String?
  accepted_by_title          String?
  accepted_by_email          String?
  accepted_at                DateTime?
  accepted_ip                String?
  created_at                 DateTime     @default(now())
  updated_at                 DateTime     @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  source_quote  CrmQuote?    @relation(fields: [source_quote_id], references: [id], onDelete: SetNull)

  @@index([organization_id, status])
  @@index([organization_id, updated_at])
  @@index([source_quote_id])
}

model AppBranding {
  id             String   @id @default("default")
  logo_data_url  String?  @db.Text
  logo_mime_type String?
  quote_from_name    String?
  quote_from_address String?
  quote_from_phone   String?
  quote_from_email   String?
  quote_prepared_by_name String?
  updated_at     DateTime @updatedAt
}